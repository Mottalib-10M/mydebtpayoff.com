---
import Layout from '../../layouts/Layout.astro';

const guides = [
  {
    title: 'Avalanche vs. Snowball Method',
    description: 'Compare the two most popular debt payoff strategies and find out which one saves you the most money.',
    href: '/guides/avalanche-vs-snowball/',
    icon: '⚖️',
  },
  {
    title: 'Debt Consolidation Guide',
    description: 'Learn when debt consolidation makes sense and how to combine multiple debts into one lower payment.',
    href: '/guides/debt-consolidation-guide/',
    icon: '🔗',
  },
  {
    title: 'Credit Card Debt Payoff',
    description: 'Proven strategies to eliminate high-interest credit card balances and stop the cycle of minimum payments.',
    href: '/guides/credit-card-debt-payoff/',
    icon: '💳',
  },
  {
    title: 'Student Loan Repayment',
    description: 'Navigate federal and private student loan repayment options to find the fastest path to freedom.',
    href: '/guides/student-loan-repayment/',
    icon: '🎓',
  },
  {
    title: 'Debt-Free Budget',
    description: 'Build a budget designed to accelerate your debt payoff without sacrificing your quality of life.',
    href: '/guides/debt-free-budget/',
    icon: '📊',
  },
  {
    title: 'Emergency Fund While Paying Debt',
    description: 'Learn how to balance building an emergency fund and paying off debt at the same time.',
    href: '/guides/emergency-fund-while-paying-debt/',
    icon: '🛡️',
  },
  {
    title: 'Debt Payoff Motivation',
    description: 'Stay motivated throughout your debt-free journey with practical tips and psychological strategies.',
    href: '/guides/debt-payoff-motivation/',
    icon: '🔥',
  },
  {
    title: 'Negotiate Lower Interest Rates',
    description: 'Step-by-step scripts and tactics to negotiate lower interest rates with your creditors.',
    href: '/guides/negotiate-lower-interest-rates/',
    icon: '📞',
  },
];
---

<Layout
  title="Debt Payoff Guides - Free Expert Resources | Debt Payoff Planner"
  description="Browse our free debt payoff guides covering avalanche vs snowball methods, debt consolidation, credit card payoff, student loans, budgeting, and more."
>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-text-muted">
      <ol class="flex items-center gap-1">
        <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
        <li class="before:content-['/'] before:mx-2">Guides</li>
      </ol>
    </nav>

    <div class="text-center mb-12">
      <h1 class="text-4xl font-extrabold text-text mb-4">Debt Payoff Guides</h1>
      <p class="text-lg text-text-muted max-w-2xl mx-auto">
        Expert guides to help you understand your options, choose the right strategy, and become debt-free faster.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {guides.map((guide) => (
        <a
          href={guide.href}
          class="group block bg-white rounded-xl border border-border p-6 hover:border-primary hover:shadow-lg transition-all duration-200"
        >
          <div class="text-3xl mb-3">{guide.icon}</div>
          <h2 class="text-lg font-bold text-text group-hover:text-primary transition-colors mb-2">
            {guide.title}
          </h2>
          <p class="text-sm text-text-muted leading-relaxed">{guide.description}</p>
          <span class="inline-block mt-4 text-sm font-semibold text-primary group-hover:underline">
            Read guide &rarr;
          </span>
        </a>
      ))}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://debtpayoffplanner.com/" },
      { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://debtpayoffplanner.com/guides/" }
    ]
  })} />
</Layout>
