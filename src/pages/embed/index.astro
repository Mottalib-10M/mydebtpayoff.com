---
/**
 * Cible de l'iframe (RECETTE §13).
 *
 * La page /widget/ explique comment integrer le calculateur ; celle-ci est ce
 * que l'iframe charge reellement. Volontairement nue : pas d'en-tete, pas de
 * pied, pas de publicite, et `noindex`, sans quoi Google indexerait deux
 * pages pour un meme contenu, la seconde concurrencant la page d'accueil.
 *
 * Le lien d'attribution reste visible : c'est la contrepartie de la gratuite
 * de l'integration, et il s'ouvre dans une nouvelle fenetre pour ne pas
 * remplacer la page hote.
 */
import '../../styles/global.css';
import DebtCalculator from '../../components/DebtCalculator';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Debt Payoff Calculator | Free Embeddable Widget</title>
    <meta
      name="description"
      content="Embeddable version of the debt payoff calculator: avalanche and snowball timelines with total interest, no advertising, for insertion by iframe on any site."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://mydebtpayoff.com/widget/" />
    <style>
      body { margin: 0; padding: 16px; background: #ffffff; }
    </style>
  </head>
  <body>
    <div class="mx-auto max-w-6xl">
      <DebtCalculator client:idle />
      <div class="mt-6 border-t border-gray-200 pt-4 text-center">
        <p class="text-xs text-gray-500">
          Calculations by
          <a
            href="https://mydebtpayoff.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-primary"
          >My Debt Payoff</a>, using 2026 consumer credit rates.
        </p>
      </div>
    </div>
  </body>
</html>
