---
/**
 * Bloc « official sources », commun aux pages pilier.
 *
 * RECETTE §7 : une page pilier cite au moins trois textes officiels. Sur un
 * sujet d'endettement des menages c'est le signal E-E-A-T le plus direct, et le
 * plus verifiable : chaque regle enoncee doit pouvoir etre remontee jusqu'a
 * l'organisme qui la fixe ou la mesure.
 *
 * Les quatre references ci-dessous sont celles dont depend reellement le
 * contenu du site : le regulateur federal du credit a la consommation, la
 * statistique officielle de l'endettement, l'administration fiscale pour le
 * traitement des dettes effacees, et le programme federal de prets etudiants.
 */
interface Props {
  /** Phrase d'introduction, adaptee au sujet de la page. */
  intro?: string;
}
const { intro } = Astro.props;

const sources = [
  {
    url: 'https://www.consumerfinance.gov/consumer-tools/debt-collection/',
    nom: 'Consumer Financial Protection Bureau',
    note: 'Rules on debt collection, validation notices and what a collector may and may not do.',
  },
  {
    url: 'https://www.federalreserve.gov/releases/g19/current/',
    nom: 'Federal Reserve, G.19 Consumer Credit release',
    note: 'Monthly figures on revolving and non-revolving consumer credit, and average interest rates.',
  },
  {
    url: 'https://www.irs.gov/taxtopics/tc431',
    nom: 'Internal Revenue Service, Topic 431',
    note: 'Tax treatment of cancelled or forgiven debt, which is generally taxable income.',
  },
  {
    url: 'https://studentaid.gov/manage-loans/repayment/plans',
    nom: 'Federal Student Aid, repayment plans',
    note: 'Official terms of income-driven and standard repayment plans for federal student loans.',
  },
];
---

<section class="mx-auto max-w-6xl px-4 mt-12 border-t border-gray-200 pt-8">
  <h2 class="text-2xl font-bold">Official sources</h2>
  <p class="mt-3 text-sm text-gray-600">
    {intro ?? 'Every rate range and rule on this page traces back to the publications below. No figure is taken from a third-party summary.'}
  </p>
  <ul class="mt-4 space-y-3">
    {sources.map((s) => (
      <li>
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-primary no-underline hover:underline"
        >
          {s.nom}
        </a>
        <p class="mt-0.5 text-sm text-gray-500">{s.note}</p>
      </li>
    ))}
  </ul>
</section>
